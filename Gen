import React, { useState } from "react";

const Generator = ({ credits, onGenerate }) => {
  const [input, setInput] = useState("");
  const [message, setMessage] = useState("");

  const handleGenerate = () => {
    if (credits <= 0) {
      setMessage("No credits left. Please buy more.");
      return;
    }
    if (!input.trim()) {
      setMessage("Please enter your game idea.");
      return;
    }
    setMessage("");
    onGenerate(input);
    setInput(""); // Clear input after generating
  };

  return (
    <div style={{ maxWidth: "500px", margin: "20px auto", textAlign: "center" }}>
      <textarea
        value={input}
        onChange={(e) => setInput(e.target.value)}
        placeholder="Describe your game idea here..."
        rows={5}
        style={{ width: "100%", padding: "10px", fontSize: "16px", borderRadius: "5px" }}
      />
      <br />
      <button
        onClick={handleGenerate}
        disabled={credits <= 0}
        style={{
          marginTop: "10px",
          padding: "10px 20px",
          fontSize: "16px",
          cursor: credits > 0 ? "pointer" : "not-allowed",
        }}
      >
        Generate Game
      </button>
      {message && <p style={{ marginTop: "15px", color: "red" }}>{message}</p>}
    </div>
  );
};

export default Generator;
